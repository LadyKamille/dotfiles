{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "hooks": {
    "Notification": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "$HOME/.config/iterm2/cc-status" }] }]
  },
  "extraKnownMarketplaces": {
    "agent-browser": {
      "source": { "source": "git", "url": "https://github.com/vercel-labs/agent-browser.git" }
    },
    "dgalarza-workflows": {
      "source": { "source": "github", "repo": "dgalarza/claude-code-workflows" },
      "autoUpdate": false
    },
    "mattpocock": {
      "source": { "source": "github", "repo": "mattpocock/skills" }
    },
    "quickstop": {
      "source": { "source": "github", "repo": "acostanzo/quickstop" },
      "autoUpdate": true
    },
    "worktrunk": {
      "source": { "source": "github", "repo": "max-sixty/worktrunk" }
    }
  },
  "enabledPlugins": {
    "agent-browser@agent-browser": true,
    "agent-ready@dgalarza-workflows": true,
    "claude-code-setup@claude-plugins-official": true,
    "claudit@quickstop": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "codebase-readiness@dgalarza-workflows": true,
    "frontend-design@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "worktrunk@worktrunk": true
  }
}
